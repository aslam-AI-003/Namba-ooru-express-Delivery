rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ━━━ VENDORS ━━━
    // Anyone can create (registration), authenticated can read
    match /vendors/{vendorId} {
      allow create: if true;
      allow read: if true;
      allow update: if true; // Admin approves/rejects
      allow delete: if false;
    }

    // ━━━ RIDERS ━━━
    match /riders/{riderId} {
      allow create: if true;
      allow read: if true;
      allow update: if true;
      allow delete: if false;
    }

    // ━━━ PRODUCTS ━━━
    match /products/{productId} {
      allow read: if true; // Everyone can see products
      allow create, update, delete: if true; // Vendors manage their products
    }

    // ━━━ ORDERS ━━━
    match /orders/{orderId} {
      allow create: if true; // Customers create orders
      allow read: if true; // Customer, vendor, rider can read
      allow update: if true; // Status changes
      allow delete: if false;
    }

    // ━━━ USERS ━━━
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // ━━━ SHOPS ━━━
    match /shops/{shopId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // ━━━ VOICE CALLS (AI Call System) ━━━
    // Server-side writes via Admin SDK (no client rules needed)
    // Admin reads for dashboard
    match /voice_calls/{callId} {
      allow read: if true; // Admin dashboard reads
      allow create, update: if true; // Server writes via Admin SDK
      allow delete: if false;
    }

    // ━━━ CUSTOMER VOICE PROFILES ━━━
    match /customer_voice_profiles/{phoneId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // ━━━ HUMAN ESCALATIONS ━━━
    match /human_escalations/{escalationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // ━━━ SMS LOGS ━━━
    match /sms_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
