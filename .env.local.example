# ==========================================
# Namma Ooru Express - Environment Variables
# ==========================================
# Copy this file to .env.local and fill in your values

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Admin (Server-side)
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# Backend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here

# WhatsApp Business API (Optional)
WHATSAPP_API_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# SMS Gateway (Optional)
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=NOEDEL

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# App Settings
NEXT_PUBLIC_APP_NAME=Namma Ooru Express
NEXT_PUBLIC_APP_URL=https://nammaooru.express
COMMISSION_PERCENTAGE=15

# ─── AI VOICE CALL ORDERING ──────────────────────────────────
# Telephony Provider (Exotel / Knowlarity / Twilio)
TELEPHONY_PROVIDER=exotel
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_SID=your_exotel_sid
EXOTEL_SUBDOMAIN=your_subdomain.exotel.com
VOICE_WEBHOOK_SECRET=your_webhook_secret_here

# AI/LLM Provider for Voice Agent
VOICE_AI_PROVIDER=claude
ANTHROPIC_API_KEY=your_anthropic_api_key
VOICE_AI_MODEL=claude-sonnet-4-20250514

# SMS Provider (MSG91 / Twilio)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=NOEOTP
MSG91_TEMPLATE_ID=your_template_id

# Voice System Config
HUMAN_AGENT_QUEUE_NUMBER=+919566700534
VOICE_SUPPORT_NUMBER=+919566700534
VOICE_MAX_CONCURRENT_CALLS=10
VOICE_CONFIDENCE_THRESHOLD=70
VOICE_HIGH_VALUE_ORDER_THRESHOLD=2000
VOICE_RECORDING_RETENTION_DAYS=90
