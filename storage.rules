rules_version = '2';

// ============================================================
// Namma Ooru Express — Firebase Storage Security Rules
// ============================================================
service firebase.storage {
  match /b/{bucket}/o {
    
    // ─── HELPER FUNCTIONS ────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }
    
    function isValidImage() {
      return request.resource.contentType.matches('image/.*') 
          && request.resource.size < 5 * 1024 * 1024; // 5MB max
    }
    
    function isValidDocument() {
      return request.resource.contentType.matches('(image/.*|application/pdf)')
          && request.resource.size < 10 * 1024 * 1024; // 10MB max
    }

    // ─── USER PROFILE IMAGES ─────────────────────────────────
    match /users/{userId}/profile/{fileName} {
      allow read: if true; // Public profile images
      allow write: if isOwner(userId) && isValidImage();
    }
    
    // ─── USER KYC DOCUMENTS (Private) ────────────────────────
    match /users/{userId}/kyc/{fileName} {
      allow read: if isOwner(userId); // Only user can view their KYC
      allow write: if isOwner(userId) && isValidDocument();
    }

    // ─── SHOP IMAGES ─────────────────────────────────────────
    match /shops/{shopId}/logo/{fileName} {
      allow read: if true; // Public shop logos
      allow write: if isAuth() && isValidImage();
    }
    
    match /shops/{shopId}/banner/{fileName} {
      allow read: if true; // Public shop banners
      allow write: if isAuth() && isValidImage();
    }
    
    match /shops/{shopId}/gallery/{fileName} {
      allow read: if true; // Public gallery images
      allow write: if isAuth() && isValidImage();
    }
    
    // ─── SHOP KYC DOCUMENTS (Private) ────────────────────────
    match /shops/{shopId}/kyc/{fileName} {
      allow read: if isAuth(); // Shop owner and admin can view
      allow write: if isAuth() && isValidDocument();
    }

    // ─── PRODUCT IMAGES ──────────────────────────────────────
    match /products/{productId}/{fileName} {
      allow read: if true; // Public product images
      allow write: if isAuth() && isValidImage();
    }

    // ─── RIDER DOCUMENTS ─────────────────────────────────────
    match /riders/{riderId}/photo/{fileName} {
      allow read: if true; // Public rider photos
      allow write: if isAuth() && isValidImage();
    }
    
    match /riders/{riderId}/kyc/{fileName} {
      allow read: if isAuth(); // Rider and admin can view
      allow write: if isAuth() && isValidDocument();
    }

    // ─── BANNERS (Admin only write) ──────────────────────────
    match /banners/{fileName} {
      allow read: if true; // Public banners
      allow write: if isAuth(); // TODO: Add admin check
    }

    // ─── CATEGORY IMAGES ─────────────────────────────────────
    match /categories/{fileName} {
      allow read: if true; // Public category images
      allow write: if isAuth(); // TODO: Add admin check
    }

    // ─── VOICE CALL RECORDINGS (Encrypted, Admin only) ──────
    match /voice_recordings/{callId}/{fileName} {
      allow read: if isAuth(); // TODO: Add admin check
      allow write: if isAuth(); // Backend writes recordings
    }

    // ─── SUPPORT TICKET ATTACHMENTS ──────────────────────────
    match /support/{ticketId}/{fileName} {
      allow read: if isAuth();
      allow write: if isAuth() && (isValidImage() || isValidDocument());
    }

    // ─── TEMP UPLOADS (24-hour expiry via lifecycle rules) ───
    match /temp/{userId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
